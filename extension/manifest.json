{
    "manifest_version": 3,
    "name": "cftest grabber",
    "version": "1.0.1",
    "description": "Grabs samples from Codeforces for the cftest CLI tool",
    "icons": {
        "16": "icon16.png",
        "32": "icon32.png",
        "48": "icon48.png",
        "128": "icon128.png"
    },
    "browser_specific_settings": {
        "gecko": {
            "id": "cftest-grabber@home.uz",
            "strict_min_version": "109.0",
            "data_collection_permissions": {
                "required": [ "none" ]
            }
        }   
    },
    "permissions": ["storage"],
    "background": {
        "scripts": ["background.js"],
        "service_worker": "background.js"
    },
    "action": {
        "default_title": "cftest: click to toggle auto-grab",
        "default_icon": {
            "16": "icon16.png",
            "32": "icon32.png"
        }
    },
    "content_scripts": [
        {
            "matches": ["https://codeforces.com/*"],
            "js": ["content.js"],
            "run_at": "document_idle"
        }
    ],
    "host_permissions": [
        "https://codeforces.com/*",
        "https://127.0.0.1/*"
    ]
}
