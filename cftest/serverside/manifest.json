{
    "manifest_version": 3,
    "name": "cftest grabber",
    "version": "1.0",
    "permissions": ["storage"],
    "background": {
        "scripts": ["background.js"],
        "service_worker": "background.js"
    },
    "action": {
        "default_title": "cftest: click to toggle auto-grab"
    },
    "content_scripts": [
        {
            "matches": ["https://codeforces.com/*"],
            "js": ["content.js"],
            "run_at": "document_idle"
        }
    ],
    "host_permissions": [
        "https://codeforces.com/*",
        "https://127.0.0.1/*"
    ]
}
